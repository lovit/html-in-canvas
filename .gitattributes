# 줄바꿈 통일 (LF)
* text=auto eol=lf

# Web
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf

# Config
*.toml  text eol=lf
*.yaml  text eol=lf
